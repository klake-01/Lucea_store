# LUCEA production configuration
# Copy to .env, fill every value, and never commit the result.

# === ENVIRONMENT ===
# production turns on the guards in backend/app/config.py: a weak JWT_SECRET
# becomes fatal, /docs and /redoc are unmounted, HSTS is sent.
ENVIRONMENT=production

# === POSTGRESQL ===
POSTGRES_USER=lucea
POSTGRES_PASSWORD=
POSTGRES_DB=lucea

# === REDIS ===
REDIS_PASSWORD=

# === MINIO (product image storage) ===
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# === MEILISEARCH ===
MEILI_MASTER_KEY=

# === AUTH ===
# At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with a short or well known value.
JWT_SECRET=
JWT_ALGORITHM=HS256

# === CORS ===
# Comma separated. Production must NOT include localhost.
CORS_ORIGINS=https://luceamaroc.com,https://www.luceamaroc.com

# === METRICS ===
# Bearer token Prometheus must present to scrape /metrics.
# Leave empty in production and the endpoint returns 404 instead.
METRICS_ALLOWED_TOKEN=

# === FRONTEND ===
# Leave empty when nginx serves the API on the same origin under /api.
# Set an absolute URL only when the API lives on another host.
VITE_API_URL=
